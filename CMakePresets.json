{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev-win",
      "displayName": "Dev (Windows)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-win",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-linux",
      "displayName": "Dev (Linux)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci-win",
      "displayName": "CI (Windows)",
      "inherits": "dev-win",
      "cacheVariables": {
        "CARHMI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-win",
      "configurePreset": "ci-win"
    },
    {
      "name": "dev-win",
      "configurePreset": "dev-win"
    },
    {
      "name": "dev-linux",
      "configurePreset": "dev-linux"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
